# ==============================================================================
# RetailPulse — Environment Configuration Template
# Copy this file to .env and adjust variables as appropriate.
# All environment variables are prefixed with RP_ as enforced by config.py.
#
# IMPORTANT SECURITY NOTICE (SEC-CFG-01, SEC-CFG-02):
# - Set strict file permissions on your live .env: `chmod 0600 .env`
# - Never commit .env to source control (.gitignore enforces this).
# - In production (RP_ENV=prod), RP_JWT_SECRET and RP_PSEUDONYM_SALT MUST be
#   randomly generated, at least 32 characters long, and distinct from examples.
#
# Generate cryptographically secure secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ==============================================================================

# Core Environment ('dev', 'test', 'prod')
RP_ENV=dev
RP_SEED=42
RP_LOG_LEVEL=INFO
RP_CURRENCY=GBP

# Database Connectivity (PostgreSQL 16)
# Separate roles: rp_app for application runtime, rp_owner for DDL/migrations (SEC-CFG-04)
RP_DATABASE_URL=postgresql+psycopg://rp_app:devpassword@localhost:5432/retailpulse
RP_DB_OWNER_URL=postgresql+psycopg://rp_owner:devownerpassword@localhost:5432/retailpulse

# Additional database passwords used by Docker Compose
POSTGRES_PASSWORD=devpassword
RP_DB_OWNER_PASSWORD=devownerpassword
RP_DB_APP_PASSWORD=devpassword
MLFLOW_DB_PASSWORD=mlflowpassword
PREFECT_DB_PASSWORD=prefectpassword

# Security & Cryptographic Secrets (SEC-AUTH-02, SEC-DATA-01)
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(48))"
RP_JWT_SECRET=insecure-dev-jwt-secret-min-32-bytes-long!
RP_JWT_EXPIRE_MINUTES=30
RP_PSEUDONYM_SALT=insecure-dev-salt-min-32-bytes-long!

# Platform Services Endpoints
RP_MLFLOW_TRACKING_URI=http://localhost:5000
RP_PREFECT_API_URL=http://localhost:4200/api
RP_API_BASE_URL=http://localhost:8000

# API, CORS & File Uploads (SEC-INP-03, SEC-WEB-02)
RP_CORS_ORIGINS=http://localhost:8501,http://localhost:8000
RP_MAX_UPLOAD_MB=100
RP_DATA_DIR=./data

# Demand Forecasting Parameters
RP_FORECAST_TOP_N=300
RP_FORECAST_HORIZON_DAYS=28
RP_BACKTEST_FOLDS=5
RP_INTERVAL_LEVEL=0.80

# Customer & Churn Analytics
RP_CHURN_WINDOW_DAYS=90
RP_CHURN_BAND_MEDIUM=0.30
RP_CHURN_BAND_HIGH=0.60
RP_RFM_WINDOW_DAYS=730
RP_DEDUPE_EXACT_ROWS=true

# Inventory Policy Optimization
RP_DEFAULT_SERVICE_LEVEL=0.95
RP_OVERSTOCK_DAYS=90

# Feature Flags & Alerts
RP_AUTO_PROMOTE=false
RP_ENABLE_DOCS=true
# RP_ALERT_WEBHOOK_URL=https://example.com/webhook
